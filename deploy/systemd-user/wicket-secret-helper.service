# The secret helper (#350): serves a linked secret's current value to wicketd, as the user who owns
# the file it is in, so the wicket user needs no ACL on it (one that a refresh rewriting the file at
# mode 0600 would drop). A systemd *user* unit: install it as that user, not as root:
#
#   mkdir -p ~/.config/systemd/user
#   cp deploy/systemd-user/wicket-secret-helper.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now wicket-secret-helper
#   loginctl enable-linger "$USER"      # keep it running while you are logged out
#   sudo wicket secret link claude-oauth --via-helper --helper-user "$USER" --pointer /claudeAiOauth/accessToken \
#       --file ~/.claude/.credentials.json
#
# It answers only the wicket user (checked by SO_PEERCRED), and only with each --secret's pointed-to
# value and its expiry: never the refresh token or anything else in the file. It listens on the
# abstract socket @wicket-secret.<your uid>, which wicketd checks is held by your uid.
# Edit --secret for each secret it serves (NAME=FILE[#POINTER[#EXPIRES_POINTER]]); %h is your home.
[Unit]
Description=wicket secret helper: serves linked secrets to wicketd as their files' owner
Documentation=https://github.com/public/wicket/blob/main/docs/how-to/store-and-link-secrets.md

[Service]
ExecStart=/usr/local/bin/wicket secret serve --for wicket \
    --secret claude-oauth=%h/.claude/.credentials.json#/claudeAiOauth/accessToken#/claudeAiOauth/expiresAt
Restart=always
RestartSec=1
UMask=0077
NoNewPrivileges=yes

[Install]
WantedBy=default.target
