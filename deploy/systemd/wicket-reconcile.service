# The reconciler (#38): ends runs whose process is gone, stops their boxes, and keeps leases and
# machines in line with the ledger. As the wicket user.
[Unit]
Description=wicket reconciler
Documentation=https://github.com/public/wicket
After=network-online.target docker.service wicketd.service
Wants=network-online.target

[Service]
User=wicket
Group=wicket
SupplementaryGroups=docker
Environment=HOME=/var/lib/wicket WICKET_HOME=/var/lib/wicket
ExecStart=/var/lib/wicket-versions/current/wicket reconcile --every 1m
UMask=0077
NoNewPrivileges=yes
ProtectSystem=full
Restart=on-failure
RestartSec=10
# What a pass starts outlives it: the supervisors (`wicket attach`) of runs it adopts, and this
# host's own node's serve. A restart (deploy/install.sh restarts this unit right after wicketd)
# stops only the reconciler: with the default, it would SIGTERM those, and a supervisor ends its
# box on SIGTERM (#529).
KillMode=process

[Install]
WantedBy=multi-user.target
