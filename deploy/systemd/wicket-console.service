# The operator console (wicket serve), as the wicket user. Its options are in /etc/wicket/console.env.
[Unit]
Description=wicket operator console
Documentation=https://github.com/public/wicket
After=network-online.target wicketd.service
Wants=network-online.target

[Service]
User=wicket
Group=wicket
SupplementaryGroups=docker
Environment=HOME=/var/lib/wicket WICKET_HOME=/var/lib/wicket
EnvironmentFile=/etc/wicket/console.env
ExecStart=/var/lib/wicket-versions/current/wicket serve $WICKET_CONSOLE_ARGS
UMask=0077
NoNewPrivileges=yes
# Limits for many boxes (#582 step 4; docs/reference/daemon.md#limits): every supervisor it
# starts is a process in this unit's cgroup. TasksMax counts their threads (about 6 each, a
# two-worker runtime and its blocking pool), so 262144 covers 10,000 supervisors with room; the
# kernel's pid_max must allow as many (see the docs). LimitNOFILE is per process: a supervisor's
# sockets, logs and ledger, and wicketd's callers' descriptors.
LimitNOFILE=1048576
TasksMax=262144
ProtectSystem=full
Restart=on-failure
# Runs started from the console are their own process groups: restarting the console keeps them.
KillMode=process

[Install]
WantedBy=multi-user.target
