# wicketd (#12): the only way other users reach wicket. Runs as the wicket system user, which owns
# /var/lib/wicket (0700) and is the only member of the docker group. Installed by deploy/install.sh.
# It runs the versions root's current build, which `wicket self update` switches (root runs only its
# own copies, through /usr/local/bin/wicket: #261).
[Unit]
Description=wicket daemon: runs wicket commands for the host's operators
Documentation=https://github.com/public/wicket
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
User=wicket
Group=wicket
SupplementaryGroups=docker
Environment=HOME=/var/lib/wicket WICKET_HOME=/var/lib/wicket
ExecStart=/var/lib/wicket-versions/current/wicket daemon
# /run/wicket/wicketd.sock. The socket is 0666: each caller is checked by its peer credentials.
RuntimeDirectory=wicket
RuntimeDirectoryMode=0755
UMask=0077
NoNewPrivileges=yes
# Limits for many boxes (#582 step 4; docs/reference/daemon.md#limits): every supervisor it
# starts is a process in this unit's cgroup. TasksMax counts their threads (about 6 each, a
# two-worker runtime and its blocking pool), so 262144 covers 10,000 supervisors with room; the
# kernel's pid_max must allow as many (see the docs). LimitNOFILE is per process: a supervisor's
# sockets, logs and ledger, and wicketd's callers' descriptors. LimitNPROC (RLIMIT_NPROC) counts
# every thread of the wicket user, wherever it runs: systemd's default (about 31,000) would stop
# about 5,000 supervisors, long before TasksMax.
LimitNOFILE=1048576
LimitNPROC=infinity
TasksMax=262144
ProtectSystem=full
Restart=on-failure
# Commands started through the daemon are its children, each in its own process group. A restart
# (deploy/install.sh, an operator's) stops only the daemon: its runs go on supervising their boxes,
# and only their callers' connections end (#455). `wicket self update` doesn't restart it at all:
# on SIGHUP it re-executes, handing its running commands to the new build. To end runs too, end
# them first (`wicket identity revoke <run>`, `wicket hibernate`).
KillMode=process
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
