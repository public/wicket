# Nothing from a package runs at install (#327): the view needs no install scripts.
ignore-scripts=true
engine-strict=true
save-exact=true
# No version younger than 7 days (design §2, principle 21). npm 11.10+ applies it when it resolves
# (`npm install`); older npm ignores it, and CI's ci/dep-age.py checks the lockfile either way.
min-release-age=7
