#!/bin/bash
# wicket in-box entrypoint. The box has no network interface except loopback. wicket's services get
# their own address, wicket.internal = 198.18.0.1 (a block reserved for benchmarking, never routed on
# a real network), so the agent keeps all of localhost for itself. This script starts as root with
# only NET_ADMIN, SETUID, SETGID and SETPCAP, just long enough to add that address; everything else,
# the forwarder included, runs as the agent's user with no capabilities at all. Enforcement happens
# outside the box: the forwarder only exposes the bind-mounted unix sockets of wicket's proxies.
set -eu

WICKET_ADDR=198.18.0.1

# gVisor's save/restore hook (`runsc checkpoint --save-restore-exec-argv="wicket-entry --restore-hook"`)
# runs this as root inside the sandbox, with GVISOR_SAVE_RESTORE_AUTO_EXEC_MODE=save, resume or restore. A
# restore drops wicket.internal's address from lo (experiment #70); wicket-fwd's listeners survive it
# and accept again as soon as the address is back, so putting it back is all a restore needs.
if [ "${1:-}" = --restore-hook ]; then
  case "${GVISOR_SAVE_RESTORE_AUTO_EXEC_MODE:-restore}" in
    restore|resume) ip addr replace "$WICKET_ADDR/32" dev lo ;;
  esac
  exit 0
fi
AS="${WICKET_AS_USER:?wicket-entry needs WICKET_AS_USER=uid:gid}"
U=${AS%%:*}
G=${AS##*:}
# Become the agent's user for good: no capabilities, none inheritable, an empty bounding set.
drop() { setpriv --reuid="$U" --regid="$G" --clear-groups --inh-caps=-all --bounding-set=-all -- "$@"; }

ip addr replace "$WICKET_ADDR/32" dev lo

# One forwarder for all three (crates/wicket-fwd): TCP_NODELAY, large buffers, splice, a thread per
# direction. Its log lines (listeners, errors, the address going missing) go to the box's stderr.
SOCK=/wicket/sock
drop wicket-fwd --listen $WICKET_ADDR:3128=$SOCK/egress.sock \
                --listen $WICKET_ADDR:8080=$SOCK/llm.sock \
                --listen $WICKET_ADDR:8081=$SOCK/gateway.sock &

# Trust the run's CA (public certificate only) alongside the system roots.
drop sh -c 'cat /etc/ssl/certs/ca-certificates.crt /wicket/ca/ca.pem > /tmp/ca-bundle.pem'
export SSL_CERT_FILE=/tmp/ca-bundle.pem CURL_CA_BUNDLE=/tmp/ca-bundle.pem GIT_SSL_CAINFO=/tmp/ca-bundle.pem \
       REQUESTS_CA_BUNDLE=/tmp/ca-bundle.pem NODE_EXTRA_CA_CERTS=/wicket/ca/ca.pem

drop mkdir -p "$HOME" "${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
drop mkdir -p /workspace/out 2>/dev/null || true   # absent when the workspace is mounted elsewhere

# Wait (briefly) for the forwarder to listen.
i=0
while [ $i -lt 50 ]; do
  if (exec 3<>/dev/tcp/$WICKET_ADDR/8080) 2>/dev/null; then break; fi
  i=$((i + 1)); sleep 0.1
done

exec setpriv --reuid="$U" --regid="$G" --clear-groups --inh-caps=-all --bounding-set=-all -- "$@"
