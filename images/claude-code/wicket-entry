#!/bin/bash
# wicket in-box entrypoint. The box has no network interface except loopback. wicket's services get
# their own address, wicket.internal = 198.18.0.1 (a block reserved for benchmarking, never routed on
# a real network), so the agent keeps all of localhost for itself. This script starts as root with
# only NET_ADMIN, SETUID, SETGID and SETPCAP, just long enough to add that address; everything else,
# the forwarder included, runs as the agent's user with no capabilities at all. Enforcement happens
# outside the box: the forwarder only exposes the bind-mounted unix sockets of wicket's proxies.
set -eu

WICKET_ADDR=198.18.0.1
# wicket's DNS answers every host the zone allows with an address of its own in this range, one per
# host (#92); QUIC to it is relayed to wicket, which terminates it as that host. One address with the
# /16 prefix makes the whole range local (gVisor refuses `ip route add local`).
SYNTHETIC=198.19.0.1/16

# gVisor's save/restore hook (`runsc checkpoint --save-restore-exec-argv="wicket-entry --restore-hook"`)
# runs this as root inside the sandbox, with GVISOR_SAVE_RESTORE_AUTO_EXEC_MODE=save, resume or restore. A
# restore drops wicket.internal's address from lo (experiment #70); wicket-fwd's listeners survive it
# and accept again as soon as the address is back, so putting it back is all a restore needs.
# Not wired yet: wicket parks boxes by rebuild today; this is for memory restore (experiment #70, H2).
if [ "${1:-}" = --restore-hook ]; then
  case "${GVISOR_SAVE_RESTORE_AUTO_EXEC_MODE:-restore}" in
    restore|resume) ip addr replace "$WICKET_ADDR/32" dev lo; ip addr replace "$SYNTHETIC" dev lo ;;
  esac
  exit 0
fi
# When each step of the box's start was reached (#287), on the host's clock (bash's EPOCHREALTIME, no
# process), written for its node as the program starts: the node times the box's start with them.
T="start ${EPOCHREALTIME:-}"
mark() { T="$T
$1 ${EPOCHREALTIME:-}"; }
fail() { echo "wicket-entry: $*" >&2; exit 1; }
AS="${WICKET_AS_USER:?wicket-entry needs WICKET_AS_USER=uid:gid}"
U=${AS%%:*}
G=${AS##*:}
# Become the agent's user for good: no capabilities, none inheritable, an empty bounding set.
DROP=(setpriv --reuid="$U" --regid="$G" --clear-groups --inh-caps=-all --bounding-set=-all --)

# The box's start spawns as few processes as it can, and waits on signals rather than polling (#287):
# under gVisor each process costs ~20-25 ms. So the forwarder, already the agent's user, also does
# the agent's setup, and tells this script over a pipe when it is done and when it listens.
#
# One forwarder for all of wicket's services (crates/wicket-fwd): TCP_NODELAY, large buffers, splice,
# a thread per direction; and datagrams, in frames over one unix connection each: QUIC (HTTP/3) to any
# synthetic address, and DNS (the box's resolver is wicket.internal). Its log lines (listeners,
# errors, the address going missing) go to the box's stderr. Started first, as a coprocess (its stdin
# and stdout are pipes to this script; `exec` in the coprocess: no shell is left behind), so its
# start overlaps with the addresses being added. With --control (crates/wicket-fwd/src/entry.rs) it:
# makes the agent's directories (/workspace/out is absent when the workspace is mounted elsewhere)
# and the CA bundle (the run's CA, public certificate only, alongside the system roots), says
# `prepared`; binds once told `listen`, says `ready`; then writes the start's steps for the node
# (best effort: an older node's socket directory may not take them) and says `done`.
SOCK=/wicket/sock
coproc FWD { exec "${DROP[@]}" wicket-fwd --control \
                --listen $WICKET_ADDR:3128=$SOCK/egress.sock \
                --listen $WICKET_ADDR:8080=$SOCK/llm.sock \
                --listen $WICKET_ADDR:8081=$SOCK/gateway.sock \
                --udp 0.0.0.0:443=$SOCK/udp.sock \
                --udp $WICKET_ADDR:53=$SOCK/udp.sock \
                --mkdir "$HOME" --mkdir "${CLAUDE_CONFIG_DIR:-$HOME/.claude}" --try-mkdir /workspace/out \
                --bundle /tmp/ca-bundle.pem=/etc/ssl/certs/ca-certificates.crt,/wicket/ca/ca.pem \
                --times-to $SOCK/entry.times; }
# Bash forgets a coprocess's descriptors once it has exited: kept under names of our own, so a
# forwarder that died early reads as the end of its pipe, not as a missing descriptor.
exec {FWD_OUT}<&"${FWD[0]}" {FWD_IN}>&"${FWD[1]}"

# The addresses, while this script still can: wicket.internal's, the links' to other boxes
# (198.18.1.1-32, one per linked name; wicket relays each link and names it in the box's hosts file,
# which it owns) and the synthetic range. One `ip -batch`, its commands made by bash itself (a
# here-string: no seq, no sed, one process; 32 separate `ip` calls took ~0.7 s under gVisor).
printf -v IPCMDS 'addr replace %s dev lo\n' 198.18.1.{1..32}/32 "$WICKET_ADDR/32" "$SYNTHETIC"
ip -batch - <<<"${IPCMDS%$'\n'}"  # the here-string adds the last newline
mark addrs

# The forwarder's setup (the directories, the CA bundle), then its listeners: the program never
# starts before every listener is bound. A forwarder that fails, or never answers, ends the box.
read -r -t 30 -u "$FWD_OUT" said || said=
[ "$said" = prepared ] || fail "wicket-fwd didn't prepare the box (see its error above)"
mark setup
echo listen >&"$FWD_IN"
read -r -t 30 -u "$FWD_OUT" said || said=
[ "$said" = ready ] || fail "wicket-fwd didn't start listening (see its error above)"
mark fwd

export SSL_CERT_FILE=/tmp/ca-bundle.pem CURL_CA_BUNDLE=/tmp/ca-bundle.pem GIT_SSL_CAINFO=/tmp/ca-bundle.pem \
       REQUESTS_CA_BUNDLE=/tmp/ca-bundle.pem NODE_EXTRA_CA_CERTS=/wicket/ca/ca.pem

# The start's steps, for the forwarder to write as the agent's user; on disk before the program
# starts (best effort). Bash makes these descriptors close-on-exec, so the program inherits neither
# pipe anyway; closing the write ends is what tells the forwarder the times are complete.
mark exec
# Both of the forwarder's stdin's write ends closed (ours and bash's) are the end of the times.
printf '%s\n' "$T" >&"$FWD_IN"
fd=${FWD[1]:-}; [ -z "$fd" ] || exec {fd}>&-
exec {FWD_IN}>&-
read -r -t 5 -u "$FWD_OUT" said || :
fd=${FWD[0]:-}; [ -z "$fd" ] || exec {fd}<&-
exec {FWD_OUT}<&-

# An interactive box's stdin comes from wicket's node over a socket (#151), so it outlives the node
# process writing it: the forwarder runs the agent and feeds it.
if [ -n "${WICKET_STDIN_SOCK:-}" ]; then set -- wicket-fwd --stdin-from "$WICKET_STDIN_SOCK" -- "$@"; fi
exec "${DROP[@]}" "$@"
